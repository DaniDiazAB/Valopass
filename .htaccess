Options -Indexes
DirectoryIndex public/index.php
RewriteEngine On
RewriteBase /valopass/

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Perfil de usuario → /valopass/user/NOMBRE-PERFIL
RewriteRule ^user/([a-zA-Z0-9_-]+)/?$ public/index.php?user=$1 [QSA,L]

# Resto de rutas (login, crear-usuario, etc.)
RewriteRule ^.*$ public/index.php [L]